# ThreatIQ backend configuration. Copy to .env.local (gitignored) and fill in. Placeholders only.

# ---- Core ------------------------------------------------------------------------------------
APP_ENV=development                # development | production (production enforces the rules below)
DATABASE_URL=sqlite:///./threatiq.db   # local development. Production: postgresql+psycopg://USER:PASSWORD@HOST:5432/threatiq
# Random value, 32+ chars. Encrypts stored integration credentials. REQUIRED in production.
# Changing it makes existing stored integration credentials unreadable (re-enter them).
SECRET_KEY=                        # e.g. output of: openssl rand -hex 32
FRONTEND_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=              # extra comma-separated browser origins; never "*"
LOG_LEVEL=INFO
LOG_JSON=true
DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=UTC

# ---- Authentication --------------------------------------------------------------------------
REGISTRATION_ENABLED=true          # false: only the very first account can register
SESSION_TTL_HOURS=12
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# ---- Limits (per minute unless noted) ---------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=60
REQUEST_MAX_BYTES=1000000
INGEST_MAX_BYTES=5000000
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=600
RATE_LIMIT_INGEST_PER_MINUTE=300
RATE_LIMIT_AI_PER_HOUR=60
AUTO_TRIAGE_MAX_PER_HOUR=30        # cap on automatic analyses per organization (keep it under RATE_LIMIT_AI_PER_HOUR)

# ---- Redis / background jobs (optional) -------------------------------------------------------
# Redis holds only disposable data (rate-limit counters, live-event pub/sub, Celery broker).
REDIS_URL=                         # redis://HOST:6379/0
CELERY_BROKER_URL=                 # defaults to REDIS_URL; when set, jobs run in Celery workers
JOB_WORKERS=2                      # in-process worker threads (when no broker is configured)
JOB_MAX_ATTEMPTS=3
AI_CONCURRENCY=2
SCHEDULER_ENABLED=true

# ---- Artifact storage (optional S3) -----------------------------------------------------------
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=                   # only for S3-compatible stores
S3_PREFIX=artifacts/
ARTIFACT_INLINE_MAX_BYTES=65536
# AWS credentials come from the standard AWS chain (ECS task role, environment, profile). Never put them here.

# ---- AI: Nebius Token Factory ------------------------------------------------------------------
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=                       # exact ID from GET {base}/models
NEBIUS_TIMEOUT_SECONDS=120
NEBIUS_MAX_TOKENS=12000            # reasoning tokens count; too low truncates the answer

# ---- Threat intelligence ---------------------------------------------------------------------
INTEL_TIMEOUT_SECONDS=20
KEV_TTL_HOURS=24
NVD_TTL_HOURS=24
NVD_API_KEY=                       # optional; raises NVD rate limits
VIRUSTOTAL_API_KEY=                # optional; used only if an org enables external enrichment
ENABLE_HISTORICAL_RETRIEVAL=true

# ---- RAG: hybrid retrieval of earlier cases (docs/rag.md) -------------------------------------
# Semantic search needs NVIDIA_API_KEY AND an organization with external enrichment enabled (alert text is
# sent to NVIDIA). Without them retrieval is keyword + exact. Semantic search is fastest on PostgreSQL + pgvector.
RAG_ENABLED=true
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
EMBEDDING_DIMENSIONS=1024            # must match migration 0006 (vector(1024)); changing it needs a new migration + re-embed
EMBEDDING_TIMEOUT_SECONDS=20
RAG_TOP_K=5
RAG_MAX_AGE_DAYS=365                 # older cases are dropped unless they share a strong indicator
RAG_MIN_SIMILARITY=0.5               # cosine floor for semantic-only matches; calibrate on your own data

# ---- Integrations ----------------------------------------------------------------------------
# Loopback / link-local / cloud-metadata endpoints are ALWAYS blocked. Private ranges are allowed in
# development and blocked in production unless you set this to true (on-premise SIEMs).
ALLOW_PRIVATE_INTEGRATION_ENDPOINTS=

# ---- Demo data (development only) --------------------------------------------------------------
ALLOW_DEMO_DATA=false              # must be false in production

# ---- Observability (optional) ------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=       # e.g. http://otel-collector:4318
METRICS_TOKEN=                     # if set, /api/v1/metrics requires "Authorization: Bearer <token>"

# ---- Microsoft Entra ID single sign-on (optional; see docs/sso-entra.md) ------------------------
# Leave all of these empty to keep password sign-in only. If you set any, set them all.
ENTRA_CLIENT_ID=                   # Application (client) ID of the app registration
ENTRA_CLIENT_SECRET=               # client secret VALUE (not its ID); rotate before it expires
ENTRA_TENANT_ID=                   # Directory (tenant) ID GUID for a single-tenant app registration
ENTRA_MULTI_TENANT=false           # true: multi-tenant app registration; leave ENTRA_TENANT_ID empty
# Must be registered on the app as a "Web" redirect URI. In local dev go through the Vite proxy so the
# session cookie lands on the page's origin:
ENTRA_REDIRECT_URI=                # http://localhost:5173/api/v1/auth/sso/entra/callback (production: https://<host>/api/v1/auth/sso/entra/callback)
ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com   # sovereign clouds use a different host
ENTRA_DEFAULT_ROLE=viewer          # viewer | analyst | admin; used when a new user's token has no ThreatIQ app role
ENTRA_AUTO_PROVISION=true          # create ThreatIQ users on first sign-in

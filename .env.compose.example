# Used by docker-compose.yml. Copy to .env.compose (gitignored). Placeholders only.

# REQUIRED
POSTGRES_PASSWORD=
SECRET_KEY=                 # 32+ random characters, e.g. output of: openssl rand -hex 32

# Optional
APP_ENV=development         # production additionally requires PostgreSQL (already used) and ALLOW_DEMO_DATA=false
FRONTEND_ORIGIN=http://localhost:8080
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=
# Optional: semantic retrieval (docs/rag.md). Needs an org with external enrichment enabled.
NVIDIA_API_KEY=
NVD_API_KEY=
VIRUSTOTAL_API_KEY=
METRICS_TOKEN=
ALLOW_DEMO_DATA=false
SENTRY_DSN=
GRAFANA_ADMIN_PASSWORD=     # only for --profile observability

# Microsoft Entra ID single sign-on (optional; see docs/sso-entra.md). Set all or none.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_REDIRECT_URI=         # https://<host>/api/v1/auth/sso/entra/callback
ENTRA_DEFAULT_ROLE=viewer
